def calculate(operation, *numbers):
    res_n = 1
    if operation == "1":
        return sum(numbers)

    elif operation == "2":
        res_n = 1
        for el in numbers:
            res_n *= el
        return res_n
        
    elif operation == '3':
            return sum(numbers) // len(numbers)


