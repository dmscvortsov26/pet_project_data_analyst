# 2 ПРОЕКТ - персональный помощник
list_job = []
while True:
    print('--Добро пожаловать в меню--')
    print('Выберите следующие пункты')
    print('1 Создать задачу и внести в список')
    print('2 Удалить задачу из списка - по ее номеру')
    print('3 Увидеть задачи из списка')
    print('4 Выход')

    power = int(input('Выбери позицию из меню: '))

    if power == 1:
        text = input("Введите задачу которую вы бы хотели внести в список: ")
        list_job.append(text)
        print("Задача добавлена в список")

    elif power == 2:
        print("Перед тем, как удалить, узнайте номер задачи")
        digit = int(input('Номер задачи на удаление: '))
        del list_job[digit]
        print("Задача удалена из списка")

    elif power == 3:
        for i, job in enumerate(list_job):
            print(f'номер задачи {i} - задача: {job} ')

    elif power == 4:
        print('До свидания!')
        break