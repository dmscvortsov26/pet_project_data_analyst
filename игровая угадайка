
from random import randint 
while True:
    print("Добро пожаловать в игровую угадайку")
    print("Будет загадно любое число от 1 до 100 включительно")
    print("Число загадано, попробуй отгадать!")

    secret = randint(1, 100)
    count = 0

    while True:
        power = int(input('Введите ваше число от 1 до 100: '))
        count += 1

        if power > secret:
            print("Ваше число больше загаданного")
            
        elif power < secret:   
            print('Ваше число меньше загаданного')
        
        elif secret == power:
            print(f"Поздравляю вы отгадали число, Количество попыток {count}")
            break

    new_text = input("Хотите сыграть еще раз? (да/нет): ")
    if new_text.lower() == 'да':
        print("Продолжим игру!")
    else:
        print('До свидания')
        break