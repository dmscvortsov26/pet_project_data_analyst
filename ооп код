class BankAccount():
    def __init__(self, name_user, balance):
        self.name_user = name_user
        self.__balance = balance

    def get_balanced(self):
        return self.__balance
    
    def deposit(self, amount):
        if amount > 0:
            self.__balance += amount
        else:
            print('Сумма пополнения должна быть положительной')
        
    def withdraw(self, amount):
        if 0 <= amount <= self.__balance:
            self.__balance -= amount
        else:
            print("Сумма не должна превышать баланс или иметь отрицательное значение")

    def transfer(self, other_account, amount):
        if 0 <= amount <= self.__balance:
            self.__balance -= amount
            other_account.deposit(amount)
        else:
            print("Некорректные данные")


acc1 = BankAccount("Дмитрий", 10000)
acc2 = BankAccount("Алексей", 2000)

print(f"До перевода: {acc1.get_balanced()} у {acc1.name_user}, {acc2.get_balanced()} у {acc2.name_user}")
acc1.transfer(acc2, 5000) # 1 пользователь переводит 2 пользователю сумму = 
print(f"После перевода: {acc1.get_balanced()} у {acc1.name_user}, {acc2.get_balanced()} у {acc2.name_user}")

