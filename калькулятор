def multiplay(a, b, operation):
    if operation == "+":
        return (a + b)
    
    elif operation == "-": 
        return (a - b)
    
    elif operation == "*": 
        return (a * b)
    
    elif operation == "/":  
        return (a / b)
    
    elif operation == "%": 
        return (a % b)
    
    elif operation == "//": 
        return (a // b)
    
    elif operation == "**":   
        return (a ** b)
    
